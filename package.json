{
  "name": "gokul-retail",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:pos": "npm run dev -w @gokul/pos",
    "dev:office": "npm run dev -w @gokul/office",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "tauri:pos": "cd apps/pos && tauri dev",
    "tauri:office": "cd apps/office && tauri dev",
    "dist:pos": "cd apps/pos && tauri build",
    "dist:office": "cd apps/office && tauri build"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@tauri-apps/cli": "2.12.4",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.2"
  }
}
