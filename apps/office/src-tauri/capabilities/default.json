{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Office window may do: its own commands plus window close and events. No file, shell or network access.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-startup-status",
    "allow-list-login-users",
    "allow-login",
    "allow-current-session",
    "allow-logout",
    "allow-lock-session",
    "allow-heartbeat",
    "allow-change-pin",
    "allow-get-status-bar",
    "allow-get-shop-settings",
    "allow-setup-owner",
    "allow-recover-owner-pin",
    "allow-save-shop-settings",
    "allow-open-screen",
    "allow-list-users",
    "allow-create-user",
    "allow-reset-pin",
    "allow-unlock-user",
    "allow-deactivate-user",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
