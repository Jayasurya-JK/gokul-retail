{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gokul Office",
  "version": "0.1.0",
  "identifier": "com.gokuloils.office",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev -w @gokul/office",
    "beforeBuildCommand": "npm run build -w @gokul/office"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Gokul Office",
        "width": 1366,
        "height": 768,
        "minWidth": 1280,
        "minHeight": 720,
        "fullscreen": true,
        "maximized": true,
        "visible": false,
        "backgroundColor": "#0A3426",
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Gokul Office"
      }
    }
  }
}
