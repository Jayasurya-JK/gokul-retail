{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the POS window may do: its own commands plus window close and events. No setup, settings-write or user-admin commands, no file, shell or network access.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-startup-status",
    "allow-list-login-users",
    "allow-login",
    "allow-current-session",
    "allow-logout",
    "allow-lock-session",
    "allow-heartbeat",
    "allow-change-pin",
    "allow-get-status-bar",
    "allow-get-shop-settings",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
